# Backend Environment Variables

# Generate a secure JWT secret (minimum 32 characters, random)
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_STRING

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority&appName=Treasury

# Instructions:
# 1. Copy this file to .env.production, .env.development, or .env.test as needed
# 2. Replace with your actual MongoDB Atlas credentials
# 3. Replace JWT_SECRET with a secure, random string